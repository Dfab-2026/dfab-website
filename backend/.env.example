# Copy this file to backend/.env and replace placeholder values.
# Keep one KEY=VALUE entry per line. Do not use angle brackets around real values.

MONGO_URL=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=dfab_db

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_SEO_MODEL=gemini-3.5-flash-lite
RESEND_API_KEY=YOUR_RESEND_API_KEY
SENDER_EMAIL=info@dfab.in
RECEIVER_EMAIL=info@dfab.in
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
CORS_ORIGINS=http://localhost:3000,https://dfab.in,https://www.dfab.in
